PORT=3000
BASE_URL=https://your-domain.railway.app

# JWT secret. REQUIRED. Generate one: openssl rand -hex 32
JWT_SECRET=

# Admin account (set before seeding)
ADMIN_EMAIL=admin@puregreen.com
ADMIN_PASSWORD=

# Admin notification emails (up to 3)
ADMIN_EMAIL_1=marko@puregreen.com
ADMIN_EMAIL_2=colleague2@puregreen.com
ADMIN_EMAIL_3=colleague3@puregreen.com

# Gmail SMTP (use an App Password, not your real password)
# Go to: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

# Seed / maintenance secret. REQUIRED. Guards /api/admin/seed, /api/admin/rotate-admin,
# /api/run-reminders and /api/email-test. Generate one: openssl rand -hex 32
SEED_SECRET=

# ── EMAIL (recommended: Resend, works on Railway) ──
# Sign up free at resend.com, create an API key, paste it here.
# Leave blank to fall back to Gmail SMTP above.
RESEND_API_KEY=
MAIL_FROM=Pure Green Franchise <onboarding@resend.dev>
